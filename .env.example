# CronoBiblia — variables de entorno (ejemplo)
#
# Copia este archivo a `.env` en la raíz del proyecto y completa los valores.
# NUNCA confirmes `.env` en git: contiene claves del proyecto.
#
# 1. Crea un proyecto en https://supabase.com/dashboard
# 2. Project Settings → API → copia la Project URL y la *anon* public key

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_TU_CLAVE_ANON_AQUI

# Clave pública de RevenueCat para iOS (Project → API keys → Public iOS SDK key).
# Solo se usa en la compilación nativa de iOS; el código del cliente solo
# contiene esta clave pública, nunca claves secretas.
VITE_REVENUECAT_IOS_KEY=appl_TU_CLAVE_PUBLICA_AQUI
